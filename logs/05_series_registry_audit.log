>     if transform == "diff"
(7 real changes made)

. 
. replace transform_formula = ///
>     "100*[ln(x_t)-ln(x_(t-1))]" ///
>     if transform == "mom_log_pct"
(16 real changes made)

. 
. replace transform_formula = ///
>     "400*[ln(x_t)-ln(x_(t-1))]" ///
>     if transform == "annualised_qoq_log"
(1 real change made)

. 
. replace transform_formula = ///
