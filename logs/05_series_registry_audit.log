(16 real changes made)

. 
. replace transform_scale = 400 ///
>     if transform == "annualised_qoq_log"
(1 real change made)

. 
. replace transform_scale = 1200 ///
>     if transform == "annualised_mom_log"
(5 real changes made)

. 
. assert !missing(transform_scale)

. 
